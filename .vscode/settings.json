{
  "runOnSave.commands": [
    {
      "match": "^(?:[A-Za-z]:|\\\\).*\\.java$",
      "command": "call .\\mvnw.cmd -ntp -DspotlessFiles=.*${fileBasenameNoExtension}[.]java spotless:check || call .\\mvnw.cmd -ntp -DspotlessFiles=.*${fileBasenameNoExtension}[.]java spotless:apply"
    },
    {
      "match": "^/.*\\.java$",
      "command": "sh ./mvnw -ntp '-DspotlessFiles=.*${fileBasenameNoExtension}[.]java' spotless:check || sh ./mvnw -ntp '-DspotlessFiles=.*${fileBasenameNoExtension}[.]java' spotless:apply"
    }
  ],
  "java.configuration.updateBuildConfiguration": "interactive"
}
